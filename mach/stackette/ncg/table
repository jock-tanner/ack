/*
 * Code generator table for Stackette, a 16-bit stack machine.
 *
 * Conventions:
 *   - locals are [pfp+n], n even, -128..126; parameters are above the saved
 *     frame pointer, so EM_BSIZE is 2 (the return address is on the return
 *     stack)
 *   - the caller removes the arguments: every function returns with `retn $0`
 *   - a function result is returned in MIDX (the low word) and MBP (the high
 *     word of a long)
 *   - a 4-byte value on the stack has its low word on top
 */

EM_WSIZE=2
EM_PSIZE=2
EM_BSIZE=0

FORMAT = "%d"

PROPERTIES

STACKPOINTER
LOCALBASE
PROGRAMCOUNTER

REGISTERS

sp : STACKPOINTER.
pfp("pfp") : LOCALBASE.
pc : PROGRAMCOUNTER.

TOKENS

constp8		= { INT num; } 2 cost(2,3) "$" num .
constn8		= { INT num; } 2 cost(2,3) "$" num .
const2		= { INT num; } 2 cost(4,6) "#" num .
addr_ext	= { ADDR off; } 2 cost(4,6) "#" off .
ext2		= { ADDR off; } 2 cost(4,8) "[" off "]" .
local2		= { INT ind; } 2 cost(2,5) "[pfp+" ind "]" .
addr_local	= { INT ind; } 2 cost(2,3) "[pfp+" ind "]" .
label		= { ADDR off; } 2 off .
onstack		= { INT dummy; } 2 cost(0,0) "" .

SETS

arith	= constp8 + constn8 + const2 + addr_ext + ext2 + local2 .
logic	= constp8 + const2 + addr_ext + ext2 + local2 .
mem2	= ext2 + local2 .
imm8	= constp8 + constn8 .

INSTRUCTIONS

cost(2,3)

ldpush "ld.push" arith:ro .
leapush "lea.push" addr_local:ro .
stpop "st.pop" mem2:wo .
stnull "st.pop null" .
addtos "add.tos" arith:ro .
subtos "sub.tos" arith:ro .
cmppop "cmp.pop" arith:ro .
cmpund "cmp.under tos" .
andtos "and.tos" logic:ro .
ortos "or.tos" logic:ro .
xortos "xor.tos" logic:ro .
addstk "add.push tos" .
substk "sub.push tos" .
andstk "and.push tos" .
orstk "or.push tos" .
xorstk "xor.push tos" .
negtos "neg tos" .
nottos "not tos" .
dupstk "ld.push tos" .
ldind "ld.tos [tos]" .
stind "st.under [tos]" .
bra label .
calla label .
skiplt "skip lt" .
skiple "skip le" .
skipeq "skip eq" .
skipne "skip ne" .
skipgt "skip gt" .
skipge "skip ge" .
retf "retf" imm8:ro .
addpsp "addp sp," imm8:ro .
mulop "mulu" .
divsop "divs" .
divuop "divu" .
dropnos "st.under null" .
ldbtos "ldb.tos [tos]" .
stbind "stb.under [tos]" .
ldundind "ld.under [tos]" .
ldtos "ld.tos" imm8:ro .
callpop "call pop" .
sxttos "sxt tos" .
addundtos "add.tos" imm8:ro .
skiplo "skip lo" .
skiphs "skip hs" .
skiphi "skip hi" .
skipls "skip ls" .
ldund "ld.under" imm8:ro .
ldnos "ld.nos" imm8:ro .
cmpkeep "cmp.tos" imm8:ro .
skippl "skip pl" .
dbltos "add.tos tos" .
shltosk "shl tos," imm8:ro .
shrtosk "shr tos," imm8:ro .
sartosk "sar tos," imm8:ro .
shlpush "shl push, tos" .
shrpush "shr push, tos" .
sarpush "sar push, tos" .
shrtos "shr tos" .
sartos "sar tos" .
shrnos "shr nos" .
sarnos "sar nos" .
rrctos "rrc tos" .
adcnos "adc.nos nos" .
adcnosop "adc.nos" arith:ro .
sbcnosop "sbc.nos" arith:ro .
andnosop "and.nos" logic:ro .
ornosop "or.nos" logic:ro .
xornosop "xor.nos" logic:ro .
notnos "not nos" .
addtos2 "add.tos [sp+2]" .
adcnos3 "adc.nos [sp+3]" .
andtos2 "and.tos [sp+2]" .
andnos3 "and.nos [sp+3]" .
ortos2 "or.tos [sp+2]" .
ornos3 "or.nos [sp+3]" .
xortos2 "xor.tos [sp+2]" .
xornos3 "xor.nos [sp+3]" .
stlo "st [sp+2], tos" .
sthi "st [sp+3], nos" .
bswaptos "bswap tos" .
ldsp1 "ld.push [sp+1]" .
ldsp3 "ld.push [sp+3]" .
jmpl "jmp" label .
nop .

MOVES

from const2 to const2
	gen nop.

TESTS

to test const2
	gen nop.

STACKINGRULES

from arith to STACK
	gen ldpush %1

from addr_local to STACK
	gen leapush %1

from onstack to STACK
	gen

COERCIONS

from constp8 yields {const2, %1.num}

from constn8 yields {const2, %1.num}

PATTERNS

/* group 1: loads */

pat loc $1>=0 && $1<=127		yields {constp8, $1}
pat loc $1>=0-128 && $1<0		yields {constn8, $1}
pat loc					yields {const2, $1}
pat ldc					yields {const2, highw($1)} {const2, loww($1)}
pat lol $1>=0-128 && $1<=126 && ($1&1)==0	yields {local2, $1}
pat ldl $1>=0-128 && $1<=124 && ($1&1)==0	yields {local2, $1+2} {local2, $1}
pat loe					yields {ext2, $1}
pat lde					yields {ext2, $1+2} {ext2, $1}
pat lae					yields {addr_ext, $1}
pat lpi					yields {addr_ext, $1}
pat lal $1>=0-128 && $1<=126 && ($1&1)==0	yields {addr_local, $1}

/* group 2: stores */

pat stl $1>=0-128 && $1<=126 && ($1&1)==0
with STACK
	gen stpop {local2, $1}

pat sdl $1>=0-128 && $1<=124 && ($1&1)==0
with STACK
	gen stpop {local2, $1}
	    stpop {local2, $1+2}

pat ste
with STACK
	gen stpop {ext2, $1}

pat sde
with STACK
	gen stpop {ext2, $1}
	    stpop {ext2, $1+2}

/* group 3: arithmetic and logic on words */

pat adi $1==2
with arith STACK
	gen addtos %1
with STACK
	gen addstk .

pat sbi $1==2
with arith STACK
	gen subtos %1
with STACK
	gen substk .

pat and $1==2
with logic STACK
	gen andtos %1
with STACK
	gen andstk .

pat ior $1==2
with logic STACK
	gen ortos %1
with STACK
	gen orstk .

pat xor $1==2
with logic STACK
	gen xortos %1
with STACK
	gen xorstk .

pat ngi $1==2
with STACK
	gen negtos .

pat com $1==2
with STACK
	gen nottos .

pat inc
with STACK
	gen addtos {constp8, 1}

pat dec
with STACK
	gen subtos {constp8, 1}

pat dup $1==2
with arith
	yields %1 %1
with STACK
	gen dupstk .

/* group 3b: arithmetic and logic on longs; low word on top */

pat adi $1==4
with arith arith STACK
	gen addtos %1
	    adcnosop %2
with STACK
	gen addtos2 .
	    adcnos3 .
	    stlo .
	    sthi .
	    addpsp {constp8, 4}

pat sbi $1==4
with arith arith STACK
	gen subtos %1
	    sbcnosop %2
with STACK
	gen notnos .
	    negtos .
	    adcnosop {constp8, 0}
	    addtos2 .
	    adcnos3 .
	    stlo .
	    sthi .
	    addpsp {constp8, 4}

pat and $1==4
with logic logic STACK
	gen andtos %1
	    andnosop %2
with STACK
	gen andtos2 .
	    andnos3 .
	    stlo .
	    sthi .
	    addpsp {constp8, 4}

pat ior $1==4
with logic logic STACK
	gen ortos %1
	    ornosop %2
with STACK
	gen ortos2 .
	    ornos3 .
	    stlo .
	    sthi .
	    addpsp {constp8, 4}

pat xor $1==4
with logic logic STACK
	gen xortos %1
	    xornosop %2
with STACK
	gen xortos2 .
	    xornos3 .
	    stlo .
	    sthi .
	    addpsp {constp8, 4}

pat ngi $1==4
with STACK
	gen notnos .
	    negtos .
	    adcnosop {constp8, 0}

pat com $1==4
with STACK
	gen nottos .
	    notnos .

/* longs: multiply, divide and compare are library calls, a, b on the stack */

pat mli $1==4
with STACK
	gen calla {label, ".mli4"}
	yields {onstack, 0} {onstack, 0}

pat mlu $1==4			leaving mli 4

pat dvi $1==4
with STACK
	gen calla {label, ".dvi4"}
	yields {onstack, 0} {onstack, 0}

pat dvu $1==4
with STACK
	gen calla {label, ".dvu4"}
	yields {onstack, 0} {onstack, 0}

pat rmi $1==4
with STACK
	gen calla {label, ".rmi4"}
	yields {onstack, 0} {onstack, 0}

pat rmu $1==4
with STACK
	gen calla {label, ".rmu4"}
	yields {onstack, 0} {onstack, 0}

pat cmi $1==4
with STACK
	gen calla {label, ".cmi4"}
	yields {onstack, 0}

pat cmu $1==4
with STACK
	gen calla {label, ".cmu4"}
	yields {onstack, 0}

pat cms $1==2			leaving sbi 2
pat cms $1==4			leaving cmu 4

pat csa $1==2
with STACK
	gen jmpl {label, ".csa2"}

pat csb $1==2
with STACK
	gen jmpl {label, ".csb2"}

pat csa $1==4
with STACK
	gen jmpl {label, ".csa4"}

pat csb $1==4
with STACK
	gen jmpl {label, ".csb4"}

/* structs and blocks: loads and stores of more than 4 bytes, one word at a
   time, the last word first so that the low word ends up on top */

pat loi $1>4 && ($1&1)==0
with STACK
	gen addtos {const2, $1-2}
	    ldundind .
	    subtos {const2, $1-2}
	leaving loi $1-2

pat sti $1>4 && ($1&1)==0
with STACK
	gen stind .
	    addtos {constp8, 2}
	leaving sti $1-2

/* blm n, bls: the destination is on top, then the source; the helper wants
   the byte count on top of both */

pat blm $1==0			leaving asp 4

pat blm $1>0
with STACK
	gen ldpush {const2, $1}
	    calla {label, ".blm"}

pat bls $1==2
with STACK
	gen calla {label, ".blm"}

pat lof				leaving adp $1 loi 2
pat ldf				leaving adp $1 loi 4
pat stf				leaving adp $1 sti 2
pat sdf				leaving adp $1 sti 4

/* unsigned and pointer arithmetic is the same as signed */

pat adu				leaving adi $1
pat sbu				leaving sbi $1
pat sbs $1==2			leaving sbi 2
pat cmp				leaving cmu 2
pat sil				leaving lol $1 sti 2

/* locals out of the reach of an offset field: through an address. The base
   is [pfp-2], which a variadic frame does not move */

pat lal $1<0-128 || $1>126
with STACK
	gen leapush {addr_local, 0-2}
	    addtos {const2, $1+2}
	yields {onstack, 0}

pat lal $1>=0-127 && $1<=125 && ($1&1)==1
with STACK
	gen leapush {addr_local, $1-1}
	    addtos {constp8, 1}
	yields {onstack, 0}

pat asp $1>126			leaving asp 126 asp $1-126
pat asp $1<0-128		leaving asp 0-128 asp $1+128

pat lol $1<0-128 || $1>126 || ($1&1)==1	leaving lal $1 loi 2
pat ldl $1<0-128 || $1>124 || ($1&1)==1	leaving lal $1 loi 4
pat stl $1<0-128 || $1>126 || ($1&1)==1	leaving lal $1 sti 2
pat sdl $1<0-128 || $1>124 || ($1&1)==1	leaving lal $1 sti 4
pat lil $1<0-128 || $1>126	leaving lol $1 loi 2

/* the trap ignore mask is not used */
pat sim
with STACK
	gen stnull .

pat dup $1==4
with arith arith
	yields %2 %1 %2 %1
with STACK
	gen ldsp1 .
	    ldsp1 .

/* group 11: floating point, in software: see mach/stackette/libfp */

pat adf $1==4
with STACK
	gen calla {label, "_sf_adf4"}
	yields {onstack, 0} {onstack, 0}

pat sbf $1==4
with STACK
	gen calla {label, "_sf_sbf4"}
	yields {onstack, 0} {onstack, 0}

pat mlf $1==4
with STACK
	gen calla {label, "_sf_mlf4"}
	yields {onstack, 0} {onstack, 0}

pat dvf $1==4
with STACK
	gen calla {label, "_sf_dvf4"}
	yields {onstack, 0} {onstack, 0}

pat ngf $1==4
with STACK
	gen calla {label, "_sf_ngf4"}
	yields {onstack, 0} {onstack, 0}

pat cmf $1==4
with STACK
	gen calla {label, "_cmf4"}
	yields {onstack, 0}

pat adf $1==8
with STACK
	gen calla {label, ".adf8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat sbf $1==8
with STACK
	gen calla {label, ".sbf8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat mlf $1==8
with STACK
	gen calla {label, ".mlf8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat dvf $1==8
with STACK
	gen calla {label, ".dvf8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat ngf $1==8
with STACK
	gen calla {label, ".ngf8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat cmf $1==8
with STACK
	gen calla {label, ".cmf8"}
	yields {onstack, 0}

pat zrf $1==4			leaving zer 4
pat zrf $1==8			leaving zer 8

pat zer $1==2			leaving loc 0
pat zer $1==4			leaving loc 0 loc 0
pat zer $1==8			leaving loc 0 loc 0 loc 0 loc 0

pat fef $1==4
with STACK
	gen calla {label, ".fef4"}
	yields {onstack, 0} {onstack, 0} {onstack, 0}

pat fef $1==8
with STACK
	gen calla {label, ".fef8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat fif $1==4
with STACK
	gen calla {label, ".fif4"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat fif $1==8
with STACK
	gen calla {label, ".fif8"}
	leaving lfr 8 lfr 8

/* conversions: the integer is widened to a long first */

pat loc loc cif $1==2		leaving loc 2 loc 4 cii loc 4 loc $2 cif
pat loc loc cuf $1==2		leaving loc 2 loc 4 cuu loc 4 loc $2 cuf

pat loc loc cif $1==4 && $2==4
with STACK
	gen calla {label, "_sf_cif4"}
	yields {onstack, 0} {onstack, 0}

pat loc loc cuf $1==4 && $2==4
with STACK
	gen calla {label, "_sf_cuf4"}
	yields {onstack, 0} {onstack, 0}

pat loc loc cif $1==4 && $2==8
with STACK
	gen calla {label, ".cif8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat loc loc cuf $1==4 && $2==8
with STACK
	gen calla {label, ".cuf8"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat loc loc cfi $1==4 && $2==4
with STACK
	gen calla {label, "_sf_cfi4"}
	yields {onstack, 0} {onstack, 0}

pat loc loc cfu $1==4 && $2==4
with STACK
	gen calla {label, "_sf_cfu4"}
	yields {onstack, 0} {onstack, 0}

pat loc loc cfi $1==8 && $2==4
with STACK
	gen calla {label, ".cfi8"}
	yields {onstack, 0} {onstack, 0}

pat loc loc cfu $1==8 && $2==4
with STACK
	gen calla {label, ".cfu8"}
	yields {onstack, 0} {onstack, 0}

pat loc loc cfi $2==2		leaving loc $1 loc 4 cfi loc 4 loc 2 cii
pat loc loc cfu $2==2		leaving loc $1 loc 4 cfu loc 4 loc 2 cuu

pat loc loc cff $1==4 && $2==8
with STACK
	gen calla {label, ".cff48"}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat loc loc cff $1==8 && $2==4
with STACK
	gen calla {label, ".cff84"}
	yields {onstack, 0} {onstack, 0}

pat loc loc cff $1==$2

/* 8-byte results of calls, returns and copies */

/* the result is already there: only the fake stack needs to know */
pat lfr $1==8
with STACK
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat cal asp lfr $3==8
with STACK
	gen calla {label, $1}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat cal lfr $2==8
with STACK
	gen calla {label, $1}
	yields {onstack, 0} {onstack, 0} {onstack, 0} {onstack, 0}

pat ret $1==8
with STACK
	gen retf {constp8, 4}

pat dup $1==8
with STACK
	gen ldsp3 .
	    ldsp3 .
	    ldsp3 .
	    ldsp3 .

pat trp
with STACK
	gen calla {label, "_fptrp"}

/* group 4: shorthands for the optimizer's output */

pat zrl				leaving loc 0 stl $1
pat zre				leaving loc 0 ste $1
pat inl				leaving lol $1 inc stl $1
pat del				leaving lol $1 dec stl $1
pat ine				leaving loe $1 inc ste $1
pat dee				leaving loe $1 dec ste $1

/* group 5: through pointers */

pat loi $1==2
with STACK
	gen ldind .

pat lil $1>=0-128 && $1<=126
with STACK
	gen ldpush {local2, $1}
	    ldind .

pat sti $1==2
with STACK
	gen stind .
	    stnull .

/* group 6: branches */

pat bra
with STACK
	gen bra {label, $1}

pat lab
with STACK
	gen labeldef $1

pat blt
with arith STACK
	gen cmppop %1
	    skipge .
	    bra {label, $1}
with STACK
	gen cmpund .
	    stnull .
	    skipge .
	    bra {label, $1}

pat ble
with arith STACK
	gen cmppop %1
	    skipgt .
	    bra {label, $1}
with STACK
	gen cmpund .
	    stnull .
	    skipgt .
	    bra {label, $1}

pat beq
with arith STACK
	gen cmppop %1
	    skipne .
	    bra {label, $1}
with STACK
	gen cmpund .
	    stnull .
	    skipne .
	    bra {label, $1}

pat bne
with arith STACK
	gen cmppop %1
	    skipeq .
	    bra {label, $1}
with STACK
	gen cmpund .
	    stnull .
	    skipeq .
	    bra {label, $1}

pat bgt
with arith STACK
	gen cmppop %1
	    skiple .
	    bra {label, $1}
with STACK
	gen cmpund .
	    stnull .
	    skiple .
	    bra {label, $1}

pat bge
with arith STACK
	gen cmppop %1
	    skiplt .
	    bra {label, $1}
with STACK
	gen cmpund .
	    stnull .
	    skiplt .
	    bra {label, $1}

pat zlt
with STACK
	gen cmppop {constp8, 0}
	    skipge .
	    bra {label, $1}

pat zle
with STACK
	gen cmppop {constp8, 0}
	    skipgt .
	    bra {label, $1}

pat zeq
with STACK
	gen cmppop {constp8, 0}
	    skipne .
	    bra {label, $1}

pat zne
with STACK
	gen cmppop {constp8, 0}
	    skipeq .
	    bra {label, $1}

pat zgt
with STACK
	gen cmppop {constp8, 0}
	    skiple .
	    bra {label, $1}

pat zge
with STACK
	gen cmppop {constp8, 0}
	    skiplt .
	    bra {label, $1}

/* group 7: calls */

/*
 * The callee removes the arguments and leaves the result on the stack, so
 * the asp after a call produces no code and lfr only tells the fake stack
 * that the result is already there
 */
pat cal asp lfr $3==2
with STACK
	gen calla {label, $1}
	yields {onstack, 0}

pat cal asp lfr $3==4
with STACK
	gen calla {label, $1}
	yields {onstack, 0} {onstack, 0}

pat cal lfr $2==2
with STACK
	gen calla {label, $1}
	yields {onstack, 0}

pat cal lfr $2==4
with STACK
	gen calla {label, $1}
	yields {onstack, 0} {onstack, 0}

pat cal asp
with STACK
	gen calla {label, $1}

pat cal
with STACK
	gen calla {label, $1}

pat asp $1==0
pat asp $1>0 && $1<=126
with STACK
	gen addpsp {constp8, $1}

pat asp $1<0 && $1>=0-128
with STACK
	gen addpsp {constn8, $1}

/*
 * The epilogue depends on the sizes of the parameters and of the locals,
 * which the assembler knows from .frame: see retf there
 */
pat ret $1==0
with STACK
	gen retf {constp8, 0}

pat ret $1==2
with STACK
	gen retf {constp8, 1}

pat ret $1==4
with STACK
	gen retf {constp8, 2}

/* group 8: pointers, multiplication and division */

pat adp $1==0
pat adp $1>0 && $1<=127
with STACK
	gen addtos {constp8, $1}

pat adp $1<0 && $1>=0-128
with STACK
	gen addtos {constn8, $1}

pat adp
with STACK
	gen addtos {const2, $1}

pat ads $1==2			leaving adi 2

pat mli $1==2
with STACK
	gen mulop .
	    dropnos .

pat mlu $1==2			leaving mli 2

pat dvi $1==2
with STACK
	gen divsop .
	    dropnos .

pat rmi $1==2
with STACK
	gen divsop .
	    stnull .

pat dvu $1==2
with STACK
	gen divuop .
	    dropnos .

pat rmu $1==2
with STACK
	gen divuop .
	    stnull .

/* group 9: bytes and longs through pointers */

pat loi $1==1
with STACK
	gen ldbtos .

pat sti $1==1
with STACK
	gen stbind .
	    stnull .

pat loi $1==4
with STACK
